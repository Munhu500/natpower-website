---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { ui, type Company } from '../data/site';

interface Props {
  company: Company;
}
const { company } = Astro.props;
---

<article class="card flex h-full flex-col p-8 md:p-12" data-reveal>
  <Logo variant="dark" size={72} wordmark={false} href={null} />
  <p class="mt-10 text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">{company.country}</p>
  <h3 class="text-h3 mt-3">{company.legalName}</h3>
  <p class="mt-2 text-[15px] text-muted">{company.location}</p>
  <p class="prose-measure mt-6">{company.role}</p>
  <div class="mt-auto pt-10">
    <a href={company.href} class="link-arrow" aria-disabled={company.hrefPlaceholder ? 'true' : undefined}>
      {ui.visit}
      <span class="sr-only">: {company.legalName}</span>
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</article>
