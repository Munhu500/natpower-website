---
import Logo from './Logo.astro';
import type { Company } from '../data/site';

interface Props {
  company: Company;
}
const { company } = Astro.props;
---

<article class="card flex h-full flex-col p-8 md:p-12" data-reveal>
  <Logo variant="dark" size={72} wordmark={false} href={null} />
  <p class="eyebrow mt-10">{company.country}</p>
  <h3 class="text-h3 mt-5">{company.legalName}</h3>
  <p class="mt-2 text-[15px] text-muted">{company.location}</p>
  <p class="prose-measure mt-6">{company.role}</p>
</article>
