---
import Media from './Media.astro';
import Icon from './Icon.astro';
import type { NewsItem } from '../data/site';

interface Props {
  item: NewsItem;
}
const { item } = Astro.props;
const external = item.href.startsWith('http');
---

<article class="card flex h-full flex-col" data-reveal>
  <div class="card-media aspect-[3/2]">
    <Media image={item.image} />
  </div>
  <div class="flex flex-1 flex-col p-7 md:p-8">
    <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">
      <time>{item.date}</time>
      <span aria-hidden="true" class="mx-2">·</span>
      {item.location}
    </p>
    <h3 class="mt-4 font-display text-[22px] font-semibold uppercase leading-[1.1] tracking-[0.02em]">
      <a
        href={item.href}
        class="card-link"
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
      >
        {item.title}
      </a>
    </h3>
    <p class="mt-4 text-[15px] text-muted">{item.excerpt}</p>
    <span class="mt-auto pt-8 text-green-600" aria-hidden="true">
      <Icon name="arrow-right" class="arrow" />
    </span>
  </div>
</article>
