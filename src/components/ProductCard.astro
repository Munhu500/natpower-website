---
import Media from './Media.astro';
import Icon from './Icon.astro';
import type { Product } from '../data/site';

interface Props {
  product: Product;
  href: string;
}
const { product, href } = Astro.props;
---

<article class="card flex h-full flex-col" data-reveal>
  <div class="card-media aspect-[4/5]">
    <Media image={product.image} />
  </div>
  <div class="flex flex-1 flex-col p-7 md:p-8">
    <h3 class="text-h3">
      <a href={href} class="card-link">{product.name}</a>
    </h3>
    <p class="mt-3 text-[15px] text-muted">{product.spec}</p>
    <span class="mt-auto pt-8 text-green-600" aria-hidden="true">
      <Icon name="arrow-right" class="arrow" />
    </span>
  </div>
</article>
