---
/**
 * Inset CTA panel. Sits inside an ivory section so it never touches
 * another dark section (e.g. the footer).
 */
import Media from './Media.astro';
import { ctaBand, group, ui } from '../data/site';

interface Props {
  background?: 'ivory' | 'white';
}
const { background = 'ivory' } = Astro.props;
---

<section class:list={['pb-[72px] md:pb-[96px] lg:pb-[128px]', background === 'white' ? 'bg-white' : 'bg-ivory']} aria-labelledby="cta-heading">
  <div class="container-site">
    <div class="on-dark relative overflow-hidden bg-green-950 text-ivory" data-reveal>
      <div class="absolute inset-0">
        <Media image={ctaBand.image} tone="dark" />
      </div>
      <div class="overlay-left absolute inset-0" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-10 px-6 py-16 sm:px-12 md:flex-row md:items-end md:justify-between md:py-24 lg:px-20">
        <div class="max-w-xl">
          <p class="eyebrow">{ctaBand.eyebrow}</p>
          <h2 id="cta-heading" class="text-h2 mt-6">{ctaBand.heading}</h2>
          <p class="mt-6 text-ivory/85">{ctaBand.text}</p>
        </div>
        <a href={group.quoteHref} class="btn btn-outline-dark shrink-0 self-start md:self-auto">{ui.getQuote}</a>
      </div>
    </div>
  </div>
</section>
