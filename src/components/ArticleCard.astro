---
import ArticleMedia from './ArticleMedia.astro';
import Icon from './Icon.astro';
import { articleHref, categorySlug, formatDate, isoDate, type Article } from '../lib/news';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { title, date, location, category, standfirst } = article.data;
---

<article class="card flex h-full flex-col" data-category={categorySlug(category)} data-reveal>
  <div class="card-media aspect-[3/2]">
    <ArticleMedia article={article} />
  </div>
  <div class="flex flex-1 flex-col p-7 md:p-8">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-700">{category}</p>
    <p class="mt-3 text-[13px] text-muted">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span aria-hidden="true" class="mx-1.5">·</span>
      {location}
    </p>
    <h3 class="mt-4 font-display text-[22px] font-semibold uppercase leading-[1.1] tracking-[0.02em]">
      <a href={articleHref(article)} class="card-link">{title}</a>
    </h3>
    <p class="mt-4 line-clamp-3 text-[15px] text-muted">{standfirst}</p>
    <span class="mt-auto pt-8 text-green-600" aria-hidden="true">
      <Icon name="arrow-right" class="arrow" />
    </span>
  </div>
</article>
