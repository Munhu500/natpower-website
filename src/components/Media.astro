---
/**
 * Renders a photograph, or a neutral labelled placeholder when no src is set.
 * Always object-fit cover, no rounded corners.
 */
import type { ImageRef } from '../data/site';

interface Props {
  image: ImageRef;
  class?: string;
  /** light = stone placeholder; dark = placeholder for imagery under a dark overlay */
  tone?: 'light' | 'dark';
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const { image, class: className = '', tone = 'light', loading = 'lazy', sizes } = Astro.props;
---

{
  image.src ? (
    <img
      src={image.src}
      alt={image.alt}
      loading={loading}
      decoding="async"
      sizes={sizes}
      class:list={['block h-full w-full object-cover', className]}
    />
  ) : (
    <div
      role="img"
      aria-label={image.alt}
      data-placeholder
      class:list={[
        'relative flex h-full w-full overflow-hidden',
        tone === 'dark'
          ? 'items-start justify-end bg-green-800 pt-28 pr-6 md:pt-32 md:pr-10 placeholder-dark'
          : 'items-center justify-center bg-stone placeholder-light',
        className,
      ]}
    >
      <span
        aria-hidden="true"
        class:list={[
          'relative z-[1] max-w-[80%] text-[11px] font-semibold uppercase tracking-[0.18em]',
          tone === 'dark' ? 'max-w-[60%] text-right text-ivory/40' : 'px-4 text-center text-muted',
        ]}
      >
        {image.placeholderLabel}
      </span>
    </div>
  )
}

<style>
  .placeholder-light {
    background-image: repeating-linear-gradient(135deg, rgb(27 31 28 / 0.035) 0 1px, transparent 1px 14px);
  }
  .placeholder-dark {
    background-image:
      radial-gradient(ellipse at 70% 30%, rgb(247 244 236 / 0.06), transparent 60%),
      repeating-linear-gradient(135deg, rgb(247 244 236 / 0.04) 0 1px, transparent 1px 14px);
  }
</style>
