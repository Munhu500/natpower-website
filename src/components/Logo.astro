---
/**
 * Natpower Group logo: the approved full-colour mark, optionally with the
 * "NATPOWER / GROUP" text wordmark beside it.
 *
 * The mark is the final, approved artwork. Use it as-is: never redraw,
 * recolour or add effects to it.
 */
import { Picture } from 'astro:assets';
import logoMark from '../assets/natpower-logo.png';
import { group, ui } from '../data/site';

interface Props {
  /** light = wordmark for dark backgrounds; dark = wordmark for light backgrounds */
  variant?: 'light' | 'dark';
  /** Rendered mark size in px (largest size it is shown at; CSS may shrink it). */
  size?: number;
  /** Show the "NATPOWER / GROUP" text wordmark beside the mark. */
  wordmark?: boolean;
  href?: string | null;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  variant = 'light',
  size = 56,
  wordmark = true,
  href = '/',
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const Wrapper = href ? 'a' : 'div';
---

<Wrapper
  href={href ?? undefined}
  class:list={['logo inline-flex items-center gap-3', className]}
  style={`--logo-size:${size}px`}
>
  <Picture
    src={logoMark}
    formats={['avif', 'webp']}
    width={size}
    height={size}
    densities={[1, 2]}
    alt={wordmark ? '' : group.logo.alt}
    loading={loading}
    decoding="async"
    class="logo-mark block shrink-0"
  />
  {
    wordmark && (
      <span class="flex flex-col leading-none">
        <span
          class:list={[
            'font-display text-[19px] font-bold tracking-[0.14em] md:text-[21px]',
            variant === 'light' ? 'text-ivory' : 'text-green-950',
          ]}
        >
          NATPOWER
        </span>
        <span class="sr-only"> </span>
        <span
          class:list={[
            'mt-1.5 font-sans text-[10px] font-medium tracking-[0.3em]',
            variant === 'light' ? 'text-gold-300' : 'text-gold-700',
          ]}
        >
          {ui.groupLabel}
        </span>
        {href && <span class="sr-only"> home</span>}
      </span>
    )
  }
  {!wordmark && href && <span class="sr-only">{group.logo.alt} home</span>}
</Wrapper>
