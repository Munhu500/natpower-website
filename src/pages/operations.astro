---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { operationsPage, products } from '../data/site';

const { hero, logistics, miningServices } = operationsPage;
const labels = operationsPage.products;
---

<BaseLayout title="Operations" description="Sulphuric acid, granular sulphur and silica sand, compliant dangerous-goods logistics and mining services.">
  <PageHero {...hero} />

  <section id="products" class="section bg-ivory" aria-labelledby="products-heading">
    <div class="container-site">
      <SectionHeading id="products-heading" eyebrow={labels.eyebrow} heading={labels.heading} />
      <div class="mt-16 space-y-20 lg:space-y-28">
        {
          products.map((p, i) => (
            <article id={p.id} class="grid scroll-mt-24 items-start gap-10 lg:grid-cols-12 lg:gap-6" aria-labelledby={`${p.id}-title`}>
              <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-2 lg:col-start-8']} data-reveal>
                <div class="aspect-[4/5] overflow-hidden">
                  <Media image={p.image} />
                </div>
              </div>
              <div class:list={['lg:col-span-6', i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-7']} data-reveal>
                <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">{`0${i + 1}`}</p>
                <h3 id={`${p.id}-title`} class="text-h2 mt-3">{p.name}</h3>
                <p class="prose-measure mt-6">{p.summary}</p>

                <h4 class="mt-10 font-sans text-[13px] font-semibold tracking-[0.12em] text-green-950">{labels.specsLabel}</h4>
                <dl class="mt-4 border-t border-stone">
                  {p.specs.map((s) => (
                    <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 border-b border-stone py-3 text-[15px]">
                      <dt class="text-muted">{s.label}</dt>
                      <dd>{s.value}</dd>
                    </div>
                  ))}
                </dl>

                <div class="mt-10 grid gap-10 sm:grid-cols-2">
                  <div>
                    <h4 class="font-sans text-[13px] font-semibold tracking-[0.12em] text-green-950">{labels.packagingLabel}</h4>
                    <ul class="mt-4 space-y-2 text-[15px]">
                      {p.packaging.map((pk) => (
                        <li class="flex items-center gap-3">
                          <Icon name="package" size={18} class="text-gold-500" />
                          {pk}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="font-sans text-[13px] font-semibold tracking-[0.12em] text-green-950">{labels.handlingLabel}</h4>
                    <p class="mt-4 text-[15px]">{p.handling}</p>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="logistics" class="section bg-white" aria-labelledby="logistics-heading">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-6">
        <div class="lg:col-span-6" data-reveal>
          <p class="eyebrow">{logistics.eyebrow}</p>
          <h2 id="logistics-heading" class="text-h2 mt-6">{logistics.heading}</h2>
          <p class="prose-measure mt-6 text-[20px] leading-[1.55] text-green-950">{logistics.lead}</p>
        </div>
        <div class="lg:col-span-5 lg:col-start-8" data-reveal>
          <div class="aspect-[3/2] overflow-hidden">
            <Media image={logistics.image} />
          </div>
        </div>
      </div>
      <div class="mt-16 grid gap-6 md:grid-cols-3" data-reveal-group>
        {
          logistics.blocks.map((b, i) => (
            <div class="border-t border-stone pt-8" data-reveal>
              <Icon name={(['truck', 'file-text', 'pickaxe'] as const)[i]} class="text-gold-500" />
              <h3 class="text-h3 mt-6">{b.title}</h3>
              <p class="mt-4">{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="mining-services" class="section bg-ivory" aria-labelledby="mining-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-5" data-reveal>
        <div class="aspect-[4/5] overflow-hidden">
          <Media image={miningServices.image} />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <p class="eyebrow">{miningServices.eyebrow}</p>
        <h2 id="mining-heading" class="text-h2 mt-6">{miningServices.heading}</h2>
        <p class="prose-measure mt-6 text-[20px] leading-[1.55] text-green-950">{miningServices.lead}</p>
        <div class="mt-10 space-y-8">
          {
            miningServices.blocks.map((b) => (
              <div class="border-t border-stone pt-6">
                <h3 class="text-h3">{b.title}</h3>
                <p class="mt-3">{b.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
