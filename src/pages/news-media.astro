---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsCard from '../components/NewsCard.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { gallery, news, newsPage, ui } from '../data/site';
---

<BaseLayout title="News & Media" description="Announcements, milestones and photography from the Natpower Group.">
  <PageHero {...newsPage.hero} />

  <section id="news" class="section scroll-mt-16 bg-ivory" aria-labelledby="news-heading">
    <div class="container-site">
      <SectionHeading id="news-heading" eyebrow={newsPage.news.eyebrow} heading={newsPage.news.heading} />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:[&>*:last-child]:col-span-2 lg:[&>*:last-child]:col-span-1" data-reveal-group>
        {news.map((n) => <NewsCard item={n} />)}
      </div>
    </div>
  </section>

  <section id="gallery" class="section scroll-mt-16 bg-white" aria-labelledby="gallery-heading">
    <div class="container-site">
      <SectionHeading id="gallery-heading" eyebrow={newsPage.gallery.eyebrow} heading={newsPage.gallery.heading} />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {
          gallery.map((g, i) => (
            <li data-reveal>
              <figure class="card group">
                {/* Lightbox trigger: layout only, not wired yet */}
                <button type="button" class="block w-full text-left" aria-label={`View image: ${g.caption}`} data-lightbox-index={i}>
                  <div class="card-media aspect-[3/2]">
                    <Media image={g.image} />
                  </div>
                </button>
                <figcaption class="p-5 text-[15px] text-muted">{g.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lightbox layout (not wired up yet). Remove `hidden` to preview. -->
  <div class="on-dark fixed inset-0 z-[70] flex flex-col bg-green-950/95 text-ivory" role="dialog" aria-modal="true" aria-label="Gallery" hidden data-lightbox>
    <div class="container-site flex h-[72px] items-center justify-between">
      <p class="font-display text-[15px] font-semibold tracking-[0.12em] text-gold-300">01 / {String(gallery.length).padStart(2, '0')}</p>
      <button type="button" class="inline-flex h-12 w-12 items-center justify-center">
        <Icon name="x" size={28} />
        <span class="sr-only">{ui.close}</span>
      </button>
    </div>
    <div class="container-site flex flex-1 items-center gap-4 pb-10">
      <button type="button" class="hero-arrow hidden sm:inline-flex"><Icon name="arrow-left" size={20} /><span class="sr-only">{ui.previousSlide}</span></button>
      <figure class="mx-auto w-full max-w-5xl">
        <div class="aspect-[3/2]"><Media image={gallery[0].image} tone="dark" /></div>
        <figcaption class="mt-4 text-ivory/70">{gallery[0].caption}</figcaption>
      </figure>
      <button type="button" class="hero-arrow hidden sm:inline-flex"><Icon name="arrow-right" size={20} /><span class="sr-only">{ui.nextSlide}</span></button>
    </div>
  </div>
</BaseLayout>
